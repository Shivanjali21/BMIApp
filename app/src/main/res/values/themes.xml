<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Bmi" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="Theme.Bmi" parent="Base.Theme.Bmi"/>

    <style name="screenBgStyle">
        <item name="android:background">@color/color_blue</item>
    </style>

    <style name="editTextStyle">
        <item name="android:backgroundTint">@color/color_black</item>
        <item name="android:textColor">@color/color_black</item>
    </style>

    <style name="buttonStyle">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/color_black</item>
    </style>

    <style name="switchColorChange" parent="Theme.AppCompat.Light">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">@color/color_purple</item>
        <!-- inactive thumb color -->
        <item name="colorSwitchThumbNormal">#FF5722</item>
        <!-- inactive track color (30% transparency) -->
        <item name="android:colorForeground">#03A9F4</item>
    </style>


</resources>

