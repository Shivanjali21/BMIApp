<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Bmi" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
    </style>

    <style name="Theme.Bmi" parent="Base.Theme.Bmi"/>

    <style name="screenBgStyle">
        <item name="android:background">@color/color_light_black</item>
    </style>

    <style name="editTextStyle">
        <item name="android:backgroundTint">@color/color_purple</item>
        <item name="android:textColor">@color/color_black</item>
    </style>

    <style name="buttonStyle">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/color_white</item>
    </style>

    <style name="switchColorChange">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">@color/color_white</item>
        <!-- inactive thumb color -->
        <item name="colorSwitchThumbNormal">#FF5722</item>
        <item name="android:colorForeground">#F3F4F3</item>
    </style>

</resources>